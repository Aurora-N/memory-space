{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --dir /absolute/path/to/memory-space --silent claude-code:hook",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --dir /absolute/path/to/memory-space --silent claude-code:hook",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --dir /absolute/path/to/memory-space --silent claude-code:hook",
            "timeout": 8
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --dir /absolute/path/to/memory-space --silent claude-code:hook",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --dir /absolute/path/to/memory-space --silent claude-code:hook",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
