{
  "name": "memory-space",
  "version": "0.1.0",
  "description": "Agent-independent, cross-session durable memory layer",
  "type": "module",
  "private": true,
  "bin": {
    "memory-space": "./src/cli/main.ts"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11 <12"
  },
  "exports": "./src/index.ts",
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "memory-space": "node --experimental-strip-types src/cli/main.ts",
    "inspector:dev": "corepack pnpm --filter @memory-space/inspector dev",
    "inspector:build": "corepack pnpm --filter @memory-space/inspector build",
    "claude-code:hook": "node --experimental-strip-types src/adapters/providers/claude-code/hook.ts",
    "codex:hook": "node --experimental-strip-types src/adapters/providers/codex/hook.ts",
    "smoke:claude:p3": "node scripts/claude-p3-real-smoke.mjs",
    "smoke:codex:p2": "node scripts/codex-p2-real-smoke.mjs",
    "smoke:p7:capability": "node scripts/p7-provider-capability-spike.mjs",
    "smoke:p7": "node scripts/p7-real-smoke.mjs",
    "smoke:p8": "node scripts/p8-real-smoke.mjs",
    "mcp:standalone": "node --experimental-strip-types src/mcp/standalone-stdio.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts eval/*.test.ts eval/quality/*.test.ts",
    "lint:source": "node scripts/lint.mjs",
    "lint:biome": "biome lint .",
    "lint:architecture": "node scripts/architecture-lint.mjs",
    "lint:comments": "node scripts/comment-lint.mjs",
    "lint": "pnpm run lint:source && pnpm run lint:biome && pnpm run lint:architecture && pnpm run lint:comments",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && tsc --noEmit && node --experimental-strip-types --test test/*.test.ts eval/*.test.ts eval/quality/*.test.ts && node scripts/codex-p2-real-smoke.mjs --self-test && node scripts/claude-p3-real-smoke.mjs --self-test && node scripts/p7-provider-capability-spike.mjs --self-test && node scripts/p7-real-smoke.mjs --self-test && node scripts/p8-real-smoke.mjs --self-test",
    "check:workspace": "corepack pnpm --recursive --include-workspace-root --if-present run check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  }
}
